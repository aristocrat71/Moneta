{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moneta",
  "version": "1.0.0",
  "identifier": "com.mitul.moneta",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Moneta",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/aristocrat71/Moneta/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyQkY1MjAyMDY5RjhGRApSV1Q5K0drZ0lQVXJCRXVKQXk4ZTE2UExyVkNEZ2NiQ0VmVW9LbTJFZldSR2NWQXJrWHFtZ1B4OQo="
    }
  }
}
